# The only local configuration file: copy this template to .env at the root.
# pnpm setup:local fills in the local Supabase keys and starts Docker services.
APP_URL=http://localhost:3000
API_PORT=4000
API_HOST=0.0.0.0
# Next.js uses this server-side proxy destination; the browser calls /api.
API_URL=http://127.0.0.1:4000

# Host address for local tools and tests. Docker uses the Supabase network
# directly; compose.yaml supplies its internal address to the API container.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Sign-in is by Google only. Create an OAuth client of type "Web application"
# in the Google Cloud console with this authorized redirect URI:
# http://127.0.0.1:54321/auth/v1/callback
# Supabase reads both values when it starts.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Required for Instagram OAuth, automations, and provider statistics.
# Empty credentials leave these integrations explicitly unavailable.
ZERNIO_API_URL=https://zernio.com/api
ZERNIO_API_KEY=

# Shared with Zernio to sign webhook deliveries to /api/webhooks/zernio.
# pnpm local:tunnel generates one if empty and registers it with Zernio.
# In production, choose a strong secret and set the same value in Zernio.
ZERNIO_WEBHOOK_SECRET=

# Only API_URL is passed from this file to Next.js. Credentials stay in the API.
