# The API image is the only one built from this repository. Its build context
# is an allowlist, so a change outside these paths does not rebuild or redeploy
# the API.
*

!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!.npmrc
!tsconfig.json

# pnpm resolves the lockfile against the manifest of every workspace.
!apps/*/package.json
!packages/*/package.json
!infra/package.json

!apps/server
!packages/api
!packages/supabase
!packages/typescript-config

**/node_modules
**/.env*
**/.turbo
**/*.tsbuildinfo
**/coverage
